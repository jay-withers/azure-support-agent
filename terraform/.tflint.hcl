config {
  call_module_type = "local"
}

plugin "terraform" {
  enabled = true
  preset  = "recommended"
}

plugin "azurerm" {
  enabled = true
  version = "0.32.0"
  source  = "github.com/terraform-linters/tflint-ruleset-azurerm"
}

# This rule wants `lifecycle { prevent_destroy = true }` on stateful resources.
# The database (chat history, audit log) and the storage account (the key that
# decrypts every stored connection credential) have it and should. The Key Vault
# deliberately does not: both its secrets are regenerated by bumping
# var.secrets_version, and prevent_destroy there would make `terraform destroy`
# fail outright while protecting nothing irreplaceable. Excluding the one type
# rather than disabling the rule keeps the guard armed for anything added later.
rule "azurerm_resources_missing_prevent_destroy" {
  enabled = true
  exclude = [
    "azurerm_key_vault",
    "azurerm_key_vault_secret",
  ]
}
