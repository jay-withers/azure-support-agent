# This project's own vault. Because it holds only this project's secrets, the
# identity's grant below can be vault-wide without widening anything: there is
# nothing else in here to read.
#
# Two secrets live here, both written by Terraform but **never stored in
# state** — their values are ephemeral and reach Azure only through write-only
# arguments:
#
#   DATABASE-URL         the asyncpg connection string, password included
#   SEED-ADMIN-PASSWORD  first-boot password for var.admin_username
#
# Unlike finances, these cannot be set by hand after apply: the container app
# references them by Key Vault URI, and a revision whose secret reference does
# not resolve fails to start. They have to exist before the app does.
resource "azurerm_key_vault" "this" {
  # checkov:skip=CKV_AZURE_42: purge protection deliberately off — see below.
  # checkov:skip=CKV_AZURE_110: same.
  # checkov:skip=CKV_AZURE_109: no network ACLs — see CKV_AZURE_189.
  # checkov:skip=CKV_AZURE_189: public access stays enabled. Restricting it needs a
  #   private endpoint (a standing monthly cost, and there is no VNet — the shared
  #   Container Apps environment is Consumption-only) or a static egress IP a
  #   scale-to-zero container app does not have.
  # checkov:skip=CKV2_AZURE_32: no private endpoint, as above.
  # `.name_unique`, not `.name`: vault names are DNS-based and globally unique
  # across every Azure tenant. The naming module's random suffix, generated once
  # and fixed in state from then on, is what makes the name actually available.
  name                = module.naming.key_vault.name_unique
  resource_group_name = azurerm_resource_group.this.name
  location            = azurerm_resource_group.this.location
  tenant_id           = data.azurerm_client_config.current.tenant_id
  sku_name            = "standard"

  # RBAC rather than access policies: the assignments below are then ordinary
  # role assignments, visible and auditable like every other permission.
  rbac_authorization_enabled = true

  # Off deliberately, so `terraform destroy` actually removes this rather than
  # leaving a soft-deleted vault holding a globally unique name. Paired with
  # `purge_soft_delete_on_destroy` in the provider block. Both secrets are
  # regenerated by bumping var.secrets_version, so nothing here is irreplaceable.
  purge_protection_enabled   = false
  soft_delete_retention_days = 7

  # Stated rather than left to the provider default, because the skip above
  # claims it: a default that changed would silently contradict the comment.
  public_network_access_enabled = true

  tags = local.tags
}

# The container app resolves its secret references through this.
resource "azurerm_role_assignment" "identity_secrets_user" {
  scope                = azurerm_key_vault.this.id
  role_definition_name = "Key Vault Secrets User"
  principal_id         = azurerm_user_assigned_identity.this.principal_id
  # Stated explicitly: without it the provider looks the principal up in the
  # directory, which fails intermittently on an identity created moments ago.
  principal_type = "ServicePrincipal"
}

# Whoever applies writes the two secrets below, and can read the seeded admin
# password back with `make admin-password`.
resource "azurerm_role_assignment" "deployer_secrets_officer" {
  for_each = toset(concat(
    [data.azurerm_client_config.current.object_id],
    var.key_vault_administrator_object_ids,
  ))

  scope                = azurerm_key_vault.this.id
  role_definition_name = "Key Vault Secrets Officer"
  principal_id         = each.value
}

# --- the secrets --------------------------------------------------------------
#
# **Ephemeral, and that is the point.** An ephemeral resource's value exists
# only for the duration of one run: it is never written to the plan or to
# state, and can only flow into write-only (`*_wo`) arguments. Terraform cannot
# compare a write-only value against anything, so it resends one only when the
# matching `*_wo_version` changes — var.secrets_version, for all three.
#
# A fresh value is generated on every run regardless, and simply discarded on
# runs where no version moved. The PostgreSQL password and DATABASE-URL are fed
# from the *same* ephemeral instance within a run, so they cannot disagree.
#
# Alphanumeric only: the password is embedded in a URL. It is still
# percent-encoded below, so allowing specials later is safe, but there is no
# entropy shortfall to justify it at this length.
ephemeral "random_password" "postgres_admin" {
  length      = 32
  special     = false
  min_upper   = 1
  min_lower   = 1
  min_numeric = 1
}

ephemeral "random_password" "seed_admin" {
  length      = 24
  special     = false
  min_upper   = 1
  min_lower   = 1
  min_numeric = 1
}

resource "azurerm_key_vault_secret" "database_url" {
  # checkov:skip=CKV_AZURE_41: no expiry. Rotation is var.secrets_version, by hand;
  #   an expiry date would only make the app fail to start on that date.
  # checkov:skip=CKV_AZURE_114: content type is irrelevant to a single opaque string.
  name         = "DATABASE-URL"
  key_vault_id = azurerm_key_vault.this.id

  # `?ssl=require`, not `sslmode=require`: the URL is handed to asyncpg through
  # SQLAlchemy, which takes asyncpg's own parameter name. Flexible Server
  # enforces TLS server-side anyway.
  #
  # The userinfo is joined separately rather than spelled `%s:%s@` in the
  # template, which checkov's secret scan reads as a hardcoded credential.
  value_wo = format(
    "postgresql+asyncpg://%s@%s:5432/%s?ssl=require",
    join(":", [
      urlencode(local.postgres_admin_login),
      urlencode(ephemeral.random_password.postgres_admin.result),
    ]),
    azurerm_postgresql_flexible_server.this.fqdn,
    azurerm_postgresql_flexible_server_database.this.name,
  )
  value_wo_version = var.secrets_version

  # The deployer needs Secrets Officer before it can write. RBAC propagation
  # can lag the assignment by a minute or two on the very first apply; a 403
  # here is fixed by re-running apply, not by changing anything.
  depends_on = [azurerm_role_assignment.deployer_secrets_officer]
}

resource "azurerm_key_vault_secret" "seed_admin_password" {
  # checkov:skip=CKV_AZURE_41: no expiry, as above — the app reads it only on first
  #   boot, and forces a change at first sign-in.
  # checkov:skip=CKV_AZURE_114: as above.
  name             = "SEED-ADMIN-PASSWORD"
  key_vault_id     = azurerm_key_vault.this.id
  value_wo         = ephemeral.random_password.seed_admin.result
  value_wo_version = var.secrets_version

  depends_on = [azurerm_role_assignment.deployer_secrets_officer]
}
